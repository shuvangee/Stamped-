# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
# Any long, private phrase. Same seed => same agent address. Keep it secret.
AGENT_SEED=replace-with-a-long-random-phrase
# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# H1B_DATA_PATH=h1b_sample.csv
# JOBS_SOURCE=muse   # jobs source (The Muse public API, no key needed); see stamped/jobs.py to add others
